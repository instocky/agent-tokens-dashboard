# Server
AGENTDASH_HOST=127.0.0.1
AGENTDASH_PORT=8021
AGENTDASH_LOG_LEVEL=INFO

# Database (read-only)
AGENTDASH_DB_PATH=C:/Users/user/.minimax/v2/sqlite/runtime-state.sqlite

# Time
AGENTDASH_TIMEZONE=Europe/Moscow

# Cost (per 1M tokens, USD)
AGENTDASH_DEFAULT_MODEL=minimax-m3
AGENTDASH_COST_INPUT_PER_1M_USD=0.23
AGENTDASH_COST_OUTPUT_PER_1M_USD=0.96

# Weekly quota
AGENTDASH_WEEKLY_CAP_TOKENS=60000000
AGENTDASH_WEEK_COUNT=4
